{
  "name": "RK Ops - Daily Expiry Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every day 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/expiry_items?select=*&expires_on=lte.{{ $now.plus({days: 60}).toFormat('yyyy-MM-dd') }}&expires_on=gte.{{ $now.toFormat('yyyy-MM-dd') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Get upcoming expiries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const milestones = [60, 30, 7, 1];\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\nconst out = [];\nfor (const item of $input.all().map(i => i.json)) {\n  const days = Math.round((Date.parse(item.expires_on + 'T00:00:00Z') - today.getTime()) / 86400000);\n  if (!milestones.includes(days)) continue;\n  out.push({ json: { ...item, days_before: days, notify_client: days <= 30 } });\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Match 60 / 30 / 7 / 1 day milestones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.OWNER_WHATSAPP }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"Reminder: {{ $json.item_type }} {{ $json.label }} ({{ $json.client_name }}) {{ $json.days_before }} din mein expire hoga ({{ $json.expires_on }}).\" }\n}"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "WhatsApp to owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -80],
      "notes": "Create an HTTP Header Auth credential: Authorization = Bearer <WhatsApp Cloud API token>. Owner messages inside the 24h window can be plain text; otherwise use an approved template."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.notify_client }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Client reminder needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.client_whatsapp }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"expiry_client_30d\",\n    \"language\": { \"code\": \"en\" },\n    \"components\": [{\n      \"type\": \"body\",\n      \"parameters\": [\n        { \"type\": \"text\", \"text\": \"{{ $json.client_name }}\" },\n        { \"type\": \"text\", \"text\": \"{{ $json.item_type }}\" },\n        { \"type\": \"text\", \"text\": \"{{ $json.label }}\" },\n        { \"type\": \"text\", \"text\": \"{{ $json.expires_on }}\" },\n        { \"type\": \"text\", \"text\": \"{{ $json.amount ? '$' + $json.amount : 'TBC' }}\" }\n      ]\n    }]\n  }\n}"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "WhatsApp to client (template)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 20],
      "notes": "Template 'expiry_client_30d' must be created and approved in Meta Business Manager first."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/reminder_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Prefer", "value": "resolution=ignore-duplicates" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"item_type\": \"{{ $('Match 60 / 30 / 7 / 1 day milestones').item.json.item_type }}\",\n  \"item_id\": \"{{ $('Match 60 / 30 / 7 / 1 day milestones').item.json.item_id }}\",\n  \"days_before\": {{ $('Match 60 / 30 / 7 / 1 day milestones').item.json.days_before }},\n  \"recipient\": \"owner\"\n}"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Log reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -80]
    }
  ],
  "connections": {
    "Every day 9:00": { "main": [[{ "node": "Get upcoming expiries", "type": "main", "index": 0 }]] },
    "Get upcoming expiries": { "main": [[{ "node": "Match 60 / 30 / 7 / 1 day milestones", "type": "main", "index": 0 }]] },
    "Match 60 / 30 / 7 / 1 day milestones": {
      "main": [[
        { "node": "WhatsApp to owner", "type": "main", "index": 0 },
        { "node": "Client reminder needed?", "type": "main", "index": 0 }
      ]]
    },
    "WhatsApp to owner": { "main": [[{ "node": "Log reminder", "type": "main", "index": 0 }]] },
    "Client reminder needed?": { "main": [[{ "node": "WhatsApp to client (template)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Karachi" }
}
